{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)"
  ],
  "packageRules": [
    {
      "description": "Group dev tooling and auto-merge when CI passes",
      "matchFileNames": [
        "requirements-dev.txt"
      ],
      "matchDepNames": [
        "pytest",
        "pytest-asyncio",
        "ruff"
      ],
      "groupName": "dev tooling",
      "automerge": true
    },
    {
      "description": "Keep GitHub Actions current",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Major updates of the bot's runtime libraries need a manual look",
      "matchFileNames": [
        "requirements.txt"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "breaking"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
