# Copy to .env and fill in. (Legacy names TOKEN / TWITCH-APP-ID / TWITCH-APP-SECRET still work.)
# The bot needs the privileged "Server Members Intent": Developer Portal -> your app -> Bot -> turn it on.
DISCORD_TOKEN=
TWITCH_APP_ID=
TWITCH_APP_SECRET=

# Optional
# OWNER_ID=123456789012345678   # Discord user id allowed to use /restart (default: the application owner)
# POLL_INTERVAL=60              # seconds between Twitch checks (min 15)
# LOG_LEVEL=INFO
# DATA_DIR=data
# LOG_DIR=logs
# DEV_GUILD_ID=                 # sync slash commands to this server only (instant, for testing)

# After an update the bot DMs the release notes to each server's owner and administrators.
# admins (default) | owner (server owners only) | off
# UPDATE_NOTIFY=admins
